# CTFY 智能体赛道 · VPS 部署环境模板
#
# 复制到 ~/.ctfy/agent.env（chmod 600），把 <...> 换成真实值。
# 这个文件**不进仓库**：仓库里只有本模板，永不写真实凭据。
#
# 依据（docs/47 §1.5，逐条有出处）：
#   - 模型调用必须走平台网关（F11，接口文档 §8.1/8.3/8.4），直连第三方中转站不合规；
#   - 交互式题（Web/Pwn）必须经 WireGuard 接入（F12，接口文档 §9.1）；
#   - 初选赛并发 3（F2，接口文档 §9.2）。

# --- 平台 -------------------------------------------------------------------
# 平台 token（pf_/pk_ 开头），由平台下发。
CTFY_TOKEN=<paste token>
# 本次比赛的 competition id（不是 suite id）。
CTFY_COMPETITION_ID=<paste competition id>
CTFY_PLATFORM=https://ctfy.tsinghua.edu.cn

# --- 模型（平台网关，OpenAI 兼容）------------------------------------------
# 网关域名形如 https://<vendor>.<session-domain>，以平台当次通知为准。
LLM_API_BASE=<https://vendor.session-domain>
LLM_API_KEY=<pk_...>
# litellm 的模型串：openai/<模型名>
STRIX_LLM=openai/<model-name>
# 网关要求显式 max_tokens（缺参全 400，2026-11-14 实测）。
LLM_MAX_TOKENS=4096
# 不让 litellm 联网取价目表。
LITELLM_LOCAL_MODEL_COST_MAP=True
STRIX_TELEMETRY=false
STRIX_RUNTIME_BACKEND=local

# --- 调度 -------------------------------------------------------------------
# 车道数：配额 3，默认 2（留一个余量给停止中/重试实例）。
CTFY_LANES=2
# 单次尝试墙钟基准（秒），依据 docs/47 §2.3.2。
CTFY_WALLCLOCK=300
CTFY_TURNS=25
# 收工时刻（ISO，本地时区可写成 2026-11-20T20:00:00+08:00）。空 = 一直跑。
CTFY_UNTIL=2026-11-20T20:00:00+08:00

# --- 路径 -------------------------------------------------------------------
# 机器上有多个 python（系统 3.9 / venv 3.11）时指定用哪个。
# CTFY_PYTHON=/usr/bin/python3
# 代码根目录（含 scripts/、src/、vendor/）。
CTFY_ROOT=/home/agent/strix-ctf-agent
# 状态目录必须在重启后保留（F9：整机重启保留工作目录）。
CTFY_STATE_DIR=/home/agent/ctfy-state
CTFY_LOG_DIR=/home/agent/ctfy-logs