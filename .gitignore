# 运行期产物：不进版本库
.venv/
__pycache__/
*.pyc
.pytest_cache/
strix_runs/
.strix/

# 跑批产物与取证
results*.jsonl
run*.log
logs/

# 本地凭据（键只能来自环境变量）
.env
.env.local
*.key

# 推送到运行机时写入的提交戳
.codex-commit

# reference materials (misc-bank holds real flags): never commit
reference/

# scratch scripts archived out of repo root
archive/tmp-scratch-*/
.probe/
$null

# 取证与快照：traces/ 含真实 flag 原文，backup/ 含未脱敏台账副本。
# 进 git 历史就再也删不干净，赔率远高于收益。只留计数与脱敏结论。
traces/
backup/
