# 模型接入。填好之后 ./run.sh / ./eval.sh 会自动读这份。
# 任何一项已经在 shell 里 export 了，就以 shell 的为准。

# 兼容 OpenAI 协议的任何端点（DeepSeek / 火山 / vLLM / LiteLLM 代理）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_API_BASE=https://llmapi.paratera.com/v1

# provider/model 形式，provider 由 litellm 解析
STRIX_LLM=openai/DeepSeek-V4.1-Flash

# 关掉遥测：评测机器不该往外发任何东西
STRIX_TELEMETRY=false
